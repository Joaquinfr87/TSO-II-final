# ============================================================
# services/zabbix/.env.example — Zabbix (copia a .env EN LA VM)
#   cd services/zabbix && cp .env.example .env
# ============================================================

ZABBIX_IMAGE_TAG=alpine-7.0-latest   # versión de las imágenes Zabbix

DB_USERNAME=zabbix                   # usuario de PostgreSQL
DB_PASSWORD=CambiarMeZabbix          # CAMBIAR: password de la BD
DB_NAME=zabbix                       # base de datos

PHP_TIMEZONE=America/Argentina/Buenos_Aires   # TZ de la web

SERVER_PORT=10051                    # puerto del server (escucha de agents)

AGENT_HOSTNAME=zabbix                 # hostname que usa el agente
