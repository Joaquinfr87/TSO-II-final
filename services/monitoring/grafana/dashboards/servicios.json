{
  "uid": "tso-servicios",
  "title": "TSO - Servicios y Backup",
  "description": "Sondas de red (blackbox) de cada servicio y estado del backup de dc1 (server/backup.sh).",
  "tags": ["tso", "servicios", "backup"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "Servicios OK",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "count(probe_success == 1) or vector(0)", "legendFormat": "ok" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Sin respuesta",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "refId": "A", "expr": "count(probe_success == 0) or vector(0)", "legendFormat": "caidos" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Alertas activas",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "alertas" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Estado del último backup",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "tso_backup_state", "legendFormat": "backup" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "sin datos",
          "mappings": [{ "type": "value", "options": { "0": { "text": "FALLÓ", "color": "red", "index": 1 }, "1": { "text": "OK", "color": "green", "index": 0 } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Última corrida del backup",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "refId": "A", "expr": "time() - tso_backup_last_run_timestamp_seconds", "legendFormat": "hace" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "noValue": "nunca",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 86400 }, { "color": "green", "value": 104400 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Duración última corrida",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "refId": "A", "expr": "tso_backup_duration_seconds", "legendFormat": "duración" }],
      "fieldConfig": {
        "defaults": { "unit": "s", "noValue": "sin datos", "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "timeseries",
      "title": "Respuesta de cada servicio (1 = OK)",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "refId": "A", "expr": "probe_success", "legendFormat": "{{job}} {{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "max": 1,
          "mappings": [{ "type": "value", "options": { "0": { "text": "SIN RESPUESTA", "color": "red", "index": 1 }, "1": { "text": "OK", "color": "green", "index": 0 } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "barAlignment": 0, "scaleDistribution": { "type": "linear" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Latencia de la sonda (s)",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "refId": "A", "expr": "probe_duration_seconds", "legendFormat": "{{job}} {{instance}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 2 }] },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "barAlignment": 0, "scaleDistribution": { "type": "linear" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Estado del backup en el tiempo (1 = OK, 0 = falló)",
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "tso_backup_state", "legendFormat": "estado" },
        { "refId": "B", "expr": "tso_backup_warnings", "legendFormat": "avisos" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false, "axisPlacement": "auto", "barAlignment": 0, "scaleDistribution": { "type": "linear" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Duración de las corridas del backup (s)",
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "targets": [{ "refId": "A", "expr": "tso_backup_duration_seconds", "legendFormat": "duración" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false, "axisPlacement": "auto", "barAlignment": 0, "scaleDistribution": { "type": "linear" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    }
  ]
}
