% --- Índices: entradas alineadas a la izquierda y compactas ------------------
\makeatletter
\newcommand{\entradaIndice}[2]{%
  \par\noindent
  \begingroup
  \renewcommand{\numberline}[1]{##1\,}%
  \makebox[\linewidth][l]{%
    \parbox[b]{\dimexpr\linewidth-\@pnumwidth-4pt\relax}{\raggedright\strut#1\strut}%
    \hspace{4pt}\hb@xt@\@pnumwidth{\hfil\strut#2}%
  }%
  \endgroup
  \par}
\newcommand{\entradaIndiceNum}[2]{%
  \par\noindent
  \begingroup
  \renewcommand{\numberline}[1]{##1:\,}%
  \makebox[\linewidth][l]{%
    \parbox[b]{\dimexpr\linewidth-\@pnumwidth-4pt\relax}{\raggedright\strut#1\strut}%
    \hspace{4pt}\hb@xt@\@pnumwidth{\hfil\strut#2}%
  }%
  \endgroup
  \par}
\renewcommand*\l@part[2]{%
  \addvspace{1em}%
  \entradaIndice{\textbf{#1}}{\textbf{#2}}}
\renewcommand*\l@section[2]{\entradaIndice{#1}{#2}}
\renewcommand*\l@subsection[2]{\entradaIndice{#1}{#2}}
\renewcommand*\l@subsubsection[2]{\entradaIndice{#1}{#2}}
\renewcommand*\l@table[2]{\entradaIndiceNum{\textbf{TABLA }\ignorespaces#1}{#2}}
\renewcommand*\l@figure[2]{\entradaIndiceNum{\textbf{FIGURA }\ignorespaces#1}{#2}}
\makeatother
\newcommand{\indicesCompactos}{%
  \setstretch{1.5}%
  \setlength{\parskip}{1pt}%
}

% --- Hipervínculos -----------------------------------------------------------
\RequirePackage[colorlinks=true, linkcolor=black, urlcolor=blue, citecolor=black]{hyperref}

