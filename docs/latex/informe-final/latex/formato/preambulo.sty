\RequirePackage[natbibapa]{apacite}

% --- Encabezado de capítulo ---------------------------------------------------
\newcommand{\textoEncabezado}[2]{%
  \parbox{\headwidth}{\raggedleft
    \setstretch{1}%
    \textbf{#1}%
    \\[-6pt]{\rule{\headwidth}{0.4pt}}%
    \if\relax\detokenize{#2}\relax\else\\[2pt]\textbf{#2}\fi
  }%
}
\newcommand{\encabezadoCapitulo}[2]{%
  \fancyhead[C]{\textoEncabezado{#1}{#2}}%
}

% --- Carátula de capítulo (1 hoja completa) -----------------------------------
% Uso: \caratulaCapitulo{1}{INTRODUCCI\'ON}
% Cada capítulo comienza con una página de presentación que ocupa una hoja
% completa. La carátula muestra "CAPÍTULO X" en mayúsculas y el título del
% capítulo debajo. La carátula no muestra número de página ni se cuenta dentro
% de la enumeración (el contador se decrementa tras su salida).
% Las secciones se numeran por capítulo (1.1, 1.2 ... y 2.1, 2.2 ...).
% El encabezado muestra el nombre del capítulo en todas las hojas y el número
% de capítulo únicamente en la primera hoja posterior a la carátula.
\newcounter{capitulo}
\renewcommand{\thesection}{\arabic{capitulo}.\arabic{section}}
\renewcommand{\theHsection}{\arabic{capitulo}.\arabic{section}}
\renewcommand{\theHsubsection}{\theHsection.\arabic{subsection}}
\renewcommand{\theHsubsubsection}{\theHsubsection.\arabic{subsubsection}}
\newcommand{\caratulaCapitulo}[2]{%
  \clearpage
  \refstepcounter{capitulo}%
  \setcounter{section}{0}%
  \pdfbookmark[0]{CAP\'ITULO #1:\ #2}{capitulo.\arabic{capitulo}}%
  \addtocontents{toc}{%
    \protect\contentsline{part}{CAP\'ITULO #1\protect\\#2}{\thepage}{\@currenthref}%
  }%
  \encabezadoCapitulo{#2}{}%
  \fancypagestyle{primeraCap}{%
    \fancyhf{}%
    \fancyfoot[R]{\thepage}%
    \fancyhead[C]{\textoEncabezado{#2}{CAP\'ITULO #1}}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0.4pt}%
  }%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{6.2cm}
    {\bfseries\Huge CAP\'ITULO #1 \par}
    \vspace{1.7cm}
    {\bfseries\LARGE #2 \par}
  \end{center}
  \clearpage
  \addtocounter{page}{-1}%
  \thispagestyle{primeraCap}%
}

