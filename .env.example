# ============================================================
# .env.example — variables de entorno (copiar a .env)
#   cp .env.example .env   y completar los valores.
#   NUNCA versionar .env (está en .gitignore).
# ============================================================

# --- Red / Server (DC) ---
HOST_IP=192.168.0.2            # IP fija del server/DC (cable al router)
DNS_DOMAIN=sudoers.lan          # dominio interno
AD_REALM=SUDOERS.LAN            # realm Kerberos
AD_NETBIOS=SUDOERS              # nombre NetBIOS del dominio
GATEWAY_IP=192.168.0.1          # IP del router (TP-Link TL-WR850N)

# --- DHCP (Kea, network_mode: host) ---
DHCP_SUBNET=192.168.0.0/24      # red única de la organización
DHCP_POOL=192.168.0.100 - 192.168.0.199
DHCP_DNS=192.168.0.2            # DNS que reciben los clientes (el DC)
DHCP_GATEWAY=192.168.0.1        # puerta de enlace del router
DHCP_NTP=192.168.0.2            # servidor de tiempo (el DC)
# Reservas por MAC: "MAC=IP=hostname;MAC2=IP2=hostname2" (IPs .50–.99)
# Después de activar, apagar el DHCP del router TP-Link (Kea lo reemplaza).
DHCP_RESERVATIONS=

# --- Web / Proxy inverso (Nginx) ---
WEB_SITE_DIR=./services/web/public

# --- Correo (Postfix + Dovecot) ---
MAIL_DOMAIN=mail.sudoers.lan
# Cuentas locales opcionales (hasta integrar LDAP AD): "user:pass user2:pass2"
MAIL_USERS=

# --- Base de datos (PostgreSQL) ---
DB_PORT=5432
POSTGRES_USER=tso
POSTGRES_PASSWORD=CambiarMePos
POSTGRES_DB=tso

# --- Impresión (CUPS) ---
CUPS_PORT=1631
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASS=CambiarMe

# --- Portainer (panel Docker) ---
PORTAINER_PORT=9443